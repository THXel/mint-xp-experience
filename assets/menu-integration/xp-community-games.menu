<Menu>
  <Name>Applications</Name>
  <Menu>
    <Name>Games</Name>
    <Exclude>
      <Filename>xp-community-minesweeper.desktop</Filename>
      <Filename>xp-community-solitaire.desktop</Filename>
      <Filename>mintxp-addon-minesweeper.desktop</Filename>
      <Filename>mintxp-addon-solitaire.desktop</Filename>
